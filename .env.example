# ============================================================
# Cloud Agent Monitoring — environment configuration
# Copy this file to ".env" and fill in real values.
# NEVER commit the real .env to source control.
# ============================================================

# --- Alibaba Cloud credentials (used by BOTH CloudMonitor + DirectMail) ---
# Create a RAM user with cms:QueryMetricLast and Dm:SingleSendMail permissions.
ALIBABA_ACCESS_KEY_ID=
ALIBABA_ACCESS_KEY_SECRET=

# Region for CloudMonitor metrics endpoint (metrics.<region>.aliyuncs.com)
CLOUDMONITOR_REGION=cn-hangzhou

# Region for DirectMail endpoint (dm.<region>.aliyuncs.com)
DIRECTMAIL_REGION=cn-hangzhou

# --- DirectMail (Agent 2 email sender) ---
# AccountName = the verified sender address configured in the DirectMail console.
DM_ACCOUNT_NAME=alert@mail.yourdomain.com
DM_FROM_ALIAS=Cloud Monitor
# Comma-separated recipient list. (DirectMail SingleSendMail takes one ToAddress;
# the app sends one mail per recipient, or comma-joins per DirectMail limits.)
ALERT_RECIPIENTS=jerry.hakim@energi-up.com

# --- App behaviour ---
# MOCK_MODE=true  -> generate synthetic metric values (no credentials needed, for local dev/demo)
# MOCK_MODE=false -> make real CloudMonitor + DirectMail API calls
MOCK_MODE=true

# Scan cadence in minutes (Agent 1 cron)
SCAN_INTERVAL_MINUTES=5

# Auto-send alert email when a threshold is breached during a scheduled scan
AUTO_ALERT_ON_BREACH=true

# Flask
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# --- Database (PostgreSQL) ---
# SQLAlchemy URL. Default targets the local docker-compose Postgres on 5440.
# Production: point this at your managed Postgres.
DATABASE_URL=postgresql+psycopg2://cloudagent:cloudagent@localhost:5440/cloudagent

# --- Auth / SSO (see Docs/SSO-TARGET-APP-INTEGRATION.md) ---
# Flask session signing key. Generate a strong random value in production:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-insecure-change-me
# Shared HS256 secret with the Downstream Hub (obtain from the Hub operator).
SSO_TOKEN_SECRET=
# Clock-skew tolerance (seconds) when verifying the short-lived SSO token.
SSO_TOKEN_LEEWAY=10
# Dev login bypass (no Hub needed). Defaults to MOCK_MODE's value if unset.
DEV_LOGIN_ENABLED=true
DEV_LOGIN_EMAIL=dev@localhost
# Cross-site SSO landing requires SameSite=None + Secure (HTTPS). Local HTTP dev
# uses Lax + non-secure; production over HTTPS should set these to None / true.
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=false

# --- Service health checks (Agent: network probes) ---
# Probe each server's services (TCP/HTTP) from the monitor. Per-server hosts and
# roles are set in config.py (INSTANCE_GROUPS). Leave a host blank to skip it.
HEALTHCHECK_ENABLED=true
HEALTHCHECK_TIMEOUT=5
