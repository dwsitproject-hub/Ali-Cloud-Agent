# ============================================================
# Cloud Agent Monitoring — environment configuration
# Copy this file to ".env" and fill in real values.
# NEVER commit the real .env to source control.
#
# This template is for the SINGLE-BOX setup (local dev / all-in-one). For the
# 3-server (FE/BE/DB) staging & production topology, use the per-server
# templates instead: deploy/env.app.example (BE server) and
# deploy/env.db.example (DB server). See README "Production topology".
# ============================================================

# --- Alibaba Cloud credentials (used by BOTH CloudMonitor + DirectMail) ---
# Create a RAM user with cms:QueryMetricLast and Dm:SingleSendMail permissions.
ALIBABA_ACCESS_KEY_ID=
ALIBABA_ACCESS_KEY_SECRET=

# Region for CloudMonitor metrics endpoint (metrics.<region>.aliyuncs.com)
CLOUDMONITOR_REGION=cn-hangzhou

# Region for DirectMail endpoint (dm.<region>.aliyuncs.com)
DIRECTMAIL_REGION=cn-hangzhou

# --- Alert email (Agent 2) ---
# Recipients (comma-separated).
ALERT_RECIPIENTS=jerry.hakim@energi-up.com
DM_FROM_ALIAS=Cloud Monitor
# Transport A: SMTP (used when SMTP_HOST is set). SMTP_SECURE=true -> SSL (465),
# false -> STARTTLS (587). SMTP_REJECT_UNAUTHORIZED=false for self-signed certs.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_REJECT_UNAUTHORIZED=true
# Transport B: Alibaba DirectMail (only when SMTP_HOST is empty). AccountName =
# the verified sender address configured in the DirectMail console.
DM_ACCOUNT_NAME=

# --- App behaviour ---
# MOCK_MODE=true  -> generate synthetic metric values (no credentials needed, for local dev/demo)
# MOCK_MODE=false -> make real CloudMonitor + DirectMail API calls
MOCK_MODE=true

# Scan cadence in minutes (Agent 1 cron)
SCAN_INTERVAL_MINUTES=5

# Auto-send alert email when a threshold is breached during a scheduled scan
AUTO_ALERT_ON_BREACH=true

# Auto-alerts fire on TRANSITIONS, not every cycle (flood control):
#  - a new breach/outage       -> alert immediately
#  - everything recovers        -> one all-clear (if ALERT_ON_RECOVERY=true)
#  - same problem still present -> a reminder only every ALERT_RENOTIFY_MINUTES
ALERT_RENOTIFY_MINUTES=60
ALERT_ON_RECOVERY=true
# A problem must persist across this many CONSECUTIVE scans before an email is
# sent (and be clear for as many before 'recovered'). Stops a metric flapping
# across its threshold from emailing every cycle. 2 x SCAN_INTERVAL_MINUTES.
ALERT_CONFIRM_SCANS=2

# Max metric queries / service probes to run concurrently per scan cycle.
SCAN_CONCURRENCY=8

# Prune scan history older than this many days after each cycle (0 = keep all).
HISTORY_RETENTION_DAYS=30

# Flask
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# --- Database (PostgreSQL) ---
# SQLAlchemy URL. Default targets the local docker-compose Postgres on 5440.
# Production: point this at your managed Postgres.
DATABASE_URL=postgresql+psycopg2://cloudagent:cloudagent@localhost:5440/cloudagent

# --- Auth ---
# Flask session signing key (OUR app's own; NOT from the Hub). Strong random in prod:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-insecure-change-me
# DWS Hub SSO via OIDC (public client, Authorization Code + PKCE — no client secret).
# Leave blank for local dev (use the dev-login bypass); fill for real SSO.
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=
OIDC_REDIRECT_URI=
OIDC_SCOPES=openid email profile
# Dev login bypass (no Hub needed). Defaults to MOCK_MODE's value if unset.
DEV_LOGIN_ENABLED=true
DEV_LOGIN_EMAIL=dev@localhost
# Cross-site SSO landing requires SameSite=None + Secure (HTTPS). Local HTTP dev
# uses Lax + non-secure; production over HTTPS should set these to None / true.
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=false

# --- Standalone frontend ---
# The UI is a separate static site (Frontend/, served by nginx). These tell the
# backend where it lives: login/SSO/logout redirect here, and it's the allowed
# CORS origin. Local single-box default is the fe container on :8080.
FRONTEND_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080

# --- Instance specification + docker workloads -------------------------------
# Specs (vCPU/RAM/disk/type/status) come from the owning product's describe API,
# so the RAM user needs ecs:DescribeInstances, ecs:DescribeDisks and
# rds:DescribeDBInstanceAttribute (all read-only) in addition to cms.
# Hardware rarely changes, so specs are cached and refreshed this often:
SPECS_REFRESH_HOURS=6
# Docker container list per host. Uses the SAME least-privilege SSH path as
# diagnostics (one extra allow-listed focus, `containers`), so it does nothing
# until DIAG_SSH_USER / DIAG_SSH_KEY are set up - see Docs/DIAGNOSTICS-SETUP.md.
# Re-install deploy/cam-diag.sh on each host after upgrading: older copies reject
# the `containers` argument and fall back to the full report.
CONTAINERS_ENABLED=true
# Roles asked for containers. Managed RDS has no shell; a router or Windows box
# has no docker - asking them just logs failures.
CONTAINER_ROLES=frontend,backend,db,web

# --- No-data handling (a blank metric is NOT a healthy metric) ---------------
# When DescribeMetricLast returns nothing, re-ask over this many minutes via
# DescribeMetricList before concluding there is no data. Agent-reported
# memory/disk datapoints land irregularly and the "last" call has a narrow
# lookback, so an empty answer used to be read as healthy - a real 95% memory
# breach went unalerted for an hour because its value kept coming back blank.
METRIC_LOOKBACK_MINUTES=15
# Alert when a metric STOPS reporting. Only fires for metrics that had a value on
# the previous scan, so hosts without the CloudMonitor agent (permanently blank
# memory/disk) stay quiet; ALERT_CONFIRM_SCANS hysteresis still applies.
ALERT_ON_NO_DATA=true

# --- SSH probe port (per role) -----------------------------------------------
# sshd is often moved off 22 on hardened hosts, and rarely uniformly across an
# estate. PROBE_SSH_PORT sets the default for every role; PROBE_<ROLE>_SSH_PORT
# overrides one role (roles: frontend, backend, db, router). Wrong port =>
# "ConnectionRefusedError" on the probe (the RST proves the host was reached);
# a port blocked by a security group times out instead.
# The same value is used for on-breach diagnostics SSH unless DIAG_SSH_PORT is set.
PROBE_SSH_PORT=22
PROBE_FRONTEND_SSH_PORT=
PROBE_BACKEND_SSH_PORT=
PROBE_DB_SSH_PORT=

# --- ApsaraDB RDS instances --------------------------------------------------
# RDS is scanned from a different CloudMonitor namespace (acs_rds_dashboard)
# than ECS. Instances registered with role "rds", or whose id starts with
# "pgm-"/"rm-", use it automatically. Leave the period BLANK (recommended) to let
# CloudMonitor pick the granularity: RDS publishes at 300s (basic) or 60s
# (enhanced) depending on the instance, and asking for the wrong one returns an
# empty result rather than an error. Set 60/300 only to pin it.
RDS_METRIC_PERIOD=
# TCP probe port for role "rds" (only used when the instance has a host set AND
# the monitor's IP is on the RDS whitelist).
PROBE_RDS_PORT=5432

# --- Service health checks (Agent: network probes) ---
# Probe each server's services (TCP/HTTP) from the monitor. Leave a host blank
# to skip probes for that box.
HEALTHCHECK_ENABLED=true
HEALTHCHECK_TIMEOUT=5

# Probe hosts for each environment's FE / BE / DB server (private IP/DNS the
# monitor can reach). Seeded into the inventory on first `flask seed`; blank
# skips probes for that box (metrics still scan). Also editable via /instances.
MONITOR_HOST_PROD_FRONTEND=
MONITOR_HOST_PROD_BACKEND=
MONITOR_HOST_PROD_DB=
MONITOR_HOST_STAGING_FRONTEND=
MONITOR_HOST_STAGING_BACKEND=
MONITOR_HOST_STAGING_DB=
# ApsaraDB RDS endpoint (blank = metrics only, no TCP probe).
MONITOR_HOST_STAGING_RDS=
