# ============================================================
# DB SERVER .env — used by docker-compose.db.yml
# Copy to ".env" ON THE DB SERVER and set a strong password.
# ============================================================

POSTGRES_USER=cloudagent
# REQUIRED: a strong, unique password. The BE server authenticates with this.
POSTGRES_PASSWORD=
POSTGRES_DB=cloudagent

# Bind Postgres to the DB server's PRIVATE IP (not the public interface).
# Leave 0.0.0.0 only if the host has no public NIC; always restrict inbound
# to the BE server in the security group regardless.
DB_BIND_IP=0.0.0.0

# Host port to publish Postgres on. Default 5432. On a SHARED server another
# Postgres is often already on 5432 — check `sudo ss -tlnp | grep ':5432 '` and
# set a free port (e.g. 5433) here. Must match the :PORT in the BE's DATABASE_URL.
DB_HOST_PORT=5432
