# ============================================================
# FRONTEND SERVER .env — used by docker-compose.fe.yml
# Copy to ".env" ON THE FE SERVER.
# ============================================================

# Single origin the browser uses (serves the UI and, via nginx, /api + /auth).
# For single-origin setups this is just this site's own URL.
API_BASE=http://your-app-origin

# Where nginx proxies /api and /auth to — the BACKEND, reachable from the FE box
# (e.g. http://<be-private-ip>:5000).
BACKEND_ORIGIN=http://10.0.0.20:5000

# Host port to publish the nginx frontend on. Default 80. On a SHARED server
# something is often already on 80 — check `sudo ss -tlnp | grep ':80 '` and set
# a free port (e.g. 8081) here; point the TLS proxy/SLB for FE_HOST at it.
FE_HOST_PORT=80
