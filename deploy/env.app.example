# ============================================================
# BACKEND SERVER .env — used by docker-compose.app.yml (and Backend/app.py)
# Copy to ".env" ON THE BE SERVER and fill in real values.
# NEVER commit the real .env.
# ============================================================

# --- Alibaba Cloud credentials (CloudMonitor metrics + DirectMail) ---
ALIBABA_ACCESS_KEY_ID=
ALIBABA_ACCESS_KEY_SECRET=
CLOUDMONITOR_REGION=ap-southeast-5
DIRECTMAIL_REGION=ap-southeast-1

# --- Alert email transport (Agent 2) ---
# Recipients (comma-separated).
ALERT_RECIPIENTS=you@example.com,ops@example.com
DM_FROM_ALIAS=Cloud Monitor
# Option A: SMTP (used when SMTP_HOST is set). SMTP_SECURE=true -> SSL (465),
# false -> STARTTLS (587). SMTP_REJECT_UNAUTHORIZED=false for self-signed certs.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=                       # defaults to SMTP_USER
SMTP_REJECT_UNAUTHORIZED=true
# Option B: Alibaba DirectMail (used only when SMTP_HOST is empty). Needs the
# Alibaba AccessKey above + a verified sender address.
DM_ACCOUNT_NAME=

# --- Behaviour (production = live) ---
MOCK_MODE=false
SCAN_INTERVAL_MINUTES=5
AUTO_ALERT_ON_BREACH=true
ALERT_RENOTIFY_MINUTES=60
ALERT_ON_RECOVERY=true
# A problem must persist across this many CONSECUTIVE scans before an email is
# sent (and be clear for as many before 'recovered'). Stops a metric flapping
# across its threshold from emailing every cycle. 2 x SCAN_INTERVAL_MINUTES.
ALERT_CONFIRM_SCANS=2
SCAN_CONCURRENCY=8
HISTORY_RETENTION_DAYS=30
HEALTHCHECK_ENABLED=true
HEALTHCHECK_TIMEOUT=5
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Host port to publish the backend on. Default 5000. On a SHARED server, check
# `sudo ss -tlnp | grep ':5000 '` and set a free port (e.g. 5001) if taken; point
# the TLS proxy/SLB for BE_HOST at it. (Container-internal port stays 5000.)
APP_HOST_PORT=5000

# --- Database: PostgreSQL on the DB SERVER (not local) ---
# Point at the DB server's PRIVATE IP/DNS and the password from env.db.example.
# The :PORT here MUST match DB_HOST_PORT on the DB server (default 5432; use the
# free port you picked there, e.g. 5433, if 5432 was taken).
DATABASE_URL=postgresql+psycopg2://cloudagent:CHANGE_ME@10.0.0.10:5432/cloudagent

# --- Auth ---
# SECRET_KEY = OUR app's own Flask session-signing key (NOT from the Hub).
# Strong random: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# DWS Hub SSO via OIDC (Authorization Code + PKCE; this app is a public client,
# so there is NO client secret). Values come from the Hub app registration.
OIDC_DISCOVERY_URL=https://<hub-host>/api/sso/.well-known/openid-configuration
OIDC_CLIENT_ID=<client_id from the Hub admin>
# A SINGLE callback URL for this deployment (NOT a list) — must equal the URL the
# browser uses and be one of the Hub's registered/allowlisted redirect URIs.
OIDC_REDIRECT_URI=https://<your-app-host>/auth/oidc/callback
OIDC_SCOPES=openid email profile
# Production uses real SSO only (no dev bypass) and secure cross-site cookies.
# NOTE: for HTTP staging on a single local domain, use SAMESITE=Lax + SECURE=false
# instead (no HTTPS → SameSite=None can't work). See Docs/DEPLOY-STAGING.md.
DEV_LOGIN_ENABLED=false
SESSION_COOKIE_SAMESITE=None
SESSION_COOKIE_SECURE=true

# --- Standalone frontend (served from the FE server) ---
# Public URL of the frontend. Login/SSO/logout redirect here, and it's the
# allowed CORS origin. Must be HTTPS in production (SameSite=None cookies).
FRONTEND_URL=https://monitor.yourdomain.com
# Browser origins allowed to call this API with credentials (comma-separated).
# Defaults to FRONTEND_URL; set explicitly if the FE is reachable via >1 origin.
CORS_ORIGINS=https://monitor.yourdomain.com

# --- Monitored inventory: probe hosts for each env's FE / BE / DB server ---
# Private IP/DNS the BE server can reach. Seeded into the inventory on first
# `flask seed`; leave blank to skip probes for that box (metrics still scan).
MONITOR_HOST_PROD_FRONTEND=
MONITOR_HOST_PROD_BACKEND=
MONITOR_HOST_PROD_DB=
MONITOR_HOST_STAGING_FRONTEND=
MONITOR_HOST_STAGING_BACKEND=
MONITOR_HOST_STAGING_DB=
